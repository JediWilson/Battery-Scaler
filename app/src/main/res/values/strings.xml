<resources>
    <string name="app_name">Rescaled Battery</string>
    <string name="app_explanation">Rescaled Battery maps your battery charge with sub-percent fuel-gauge precision into three power zones: 0–19% becomes 0–95% Emergency (red), 20–80% becomes 0–100% Normal (white), and 81–100% becomes 5–100% Excess (blue). While charging, the capsule turns green with a lightning bolt.</string>

    <string name="accessibility_service_description">Draws the non-interactive Rescaled Battery capsule directly above the status-bar battery icon. Never reads screen content or intercepts touches.</string>

    <string name="overlay_toggle_title">Status bar overlay</string>
    <string name="overlay_toggle_subtitle_on">Covering the status-bar battery icon</string>
    <string name="overlay_toggle_subtitle_off">Hidden until enabled</string>

    <string name="grant_overlay_permission_button">Grant overlay permission</string>
    <string name="permission_needed_title">Accessibility overlay required</string>
    <string name="permission_needed_message">To draw directly on top of Android\'s status-bar battery icon, enable Rescaled Battery under Accessibility settings. (If Android shows \"Restricted setting\", open App Info → ⋮ → Allow restricted settings first.)</string>
    <string name="permission_denied_message">Accessibility overlay permission was not enabled. Enable Rescaled Battery in Accessibility settings before turning the overlay on.</string>

